# Optional build-side token for `npm run social-previews` only.
# Never prefix secrets with VITE_: Vite exposes those values to browser code.
# A fine-grained token limited to public repository metadata is sufficient.
GITHUB_TOKEN=

# Server-side OpenAI key for the portfolio chatbot (api/chat.ts). Create one at
# https://platform.openai.com/api-keys. Set it in Vercel's Environment Variables for
# production; locally, `npm run dev` reads it from .env. Never prefix it with VITE_.
# CHAT_MODEL optionally overrides the model (default gpt-5-mini; e.g. gpt-5.4-mini).
OPENAI_API_KEY=
CHAT_MODEL=

# Optional build-side key for `npm run narration` only (renders the voice-guide MP3s).
# ELEVENLABS_VOICE_ID / ELEVENLABS_MODEL_ID may also be set to override the defaults.
ELEVENLABS_API_KEY=
